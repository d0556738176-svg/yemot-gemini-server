# Required for the main voice-answer path
# Prefer GEMINI_API_KEYS; GEMINI_API_KEY is a legacy single-key alias.
GEMINI_API_KEYS=
GEMINI_API_KEY=
YEMOT_API_USERNAME=
YEMOT_API_PASSWORD=
YEMOT_API_KEY=
PUBLIC_BASE_URL=
DASHBOARD_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_BACKUP_API_KEY=
YOUTUBE_GEMINI_MODEL=gemini-3.8-flash
YOUTUBE_REGION_CODE=IL

# Optional: direct public-web search/extraction provider. Without a key, the SDK's keyless mode may be rate-limited.
TAVILY_API_KEY=

# Optional: explicit "חפש ב-ChatGPT" live web search (OpenAI Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PHONE_MODEL=
OPENAI_PHONE_TIMEOUT_MS=9000
OPENAI_WEB_SEARCH_MODEL=gpt-5.5
OPENAI_WEB_SEARCH_TIMEOUT_MS=18000

# Optional: independent text-only fallbacks for Branch 1 when Gemini quota is exhausted
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Leave blank to use a shorter timeout for fast phone turns and a longer one for normal turns.
GROQ_TIMEOUT_MS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Leave blank to use a shorter timeout for fast phone turns and a longer one for normal turns.
OPENROUTER_TIMEOUT_MS=

# Optional speech-to-text and independent Gemini-project fallback
DEEPGRAM_API_KEY=
DEEPGRAM_BACKUP_API_KEY=
YEMOT_BACKUP_DEEPGRAM_API_KEY=
GEMINI_BACKUP_API_KEY=
YEMOT_BACKUP_GEMINI_API_KEY=
GEMINI_BACKUP_MODEL=

# Optional: use supported models; old gemini-3.5-flash is normalized to gemini-3.6-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_TRANSCRIBE_VOCABULARY=
DEEPGRAM_KEYTERMS=

# Optional: media analysis and transit lookups. These keys are only used by their specific features.
MEDIA_GEMINI_API_KEY=
MEDIA_GEMINI_MODEL=gemini-3.8-flash
GOOGLE_VISION_API_KEY=
GOOGLE_MAPS_API_KEY=

# Optional: news and phone-answer tuning
NEWS_RSS_TIMEOUT_MS=4500
NEWS_SYNTHESIS_TIMEOUT_MS=6000
BRANCH1_PHONE_GEMINI_BUDGET_MS=7500
PHONE_GEMINI_TOTAL_BUDGET_MS=4000
PHONE_GEMINI_BACKUP_BUDGET_MS=3000
LONG_ANSWER_MAX_CHARS=12000
ENABLE_AI_OPENING=true

# Optional: persistence and authorized audio files only (never put YouTube stream URLs here)
SUPABASE_URL=
SUPABASE_KEY=
AUTHORIZED_AUDIO_HOSTS=
AUTHORIZED_AUDIO_SOURCES_JSON=

# Optional behavior and timeout tuning
AI_SYSTEM_INSTRUCTION=
FIRST_CALL_MESSAGE=
YEMOT_AUDIO_MIME_TYPE=audio/wav
REQUEST_TIMEOUT_MS=30000
PHONE_GEMINI_TIMEOUT_MS=12000
LONG_ANSWER_TIMEOUT_MS=90000
DIRECT_WEB_QUERY_TIMEOUT_MS=4500
PHONE_DEEPGRAM_TIMEOUT_MS=18000
MEDIA_ANALYSIS_TIMEOUT_MS=45000
MEDIA_SEARCH_TIMEOUT_MS=18000
MEDIA_MAX_CANDIDATES=6
MEDIA_MAX_IMAGE_BYTES=12000000
MEDIA_MAX_VIDEO_BYTES=95000000
GEMINI_QUOTA_COOLDOWN_MS=15000
YOUTUBE_AUTHORIZED_SOURCE_TIMEOUT_MS=12000
YOUTUBE_AUTHORIZED_PLAYBACK_TIMEOUT_MS=90000
YOUTUBE_AUTHORIZED_FFMPEG_TIMEOUT_MS=30000
YOUTUBE_AUTHORIZED_UPLOAD_TIMEOUT_MS=20000
YOUTUBE_AUTHORIZED_VERIFY_TIMEOUT_MS=8000
YEMOT_VOICE_OPTIONS=1:Elik_2100,2:Jacob,3:ymMale
PORT=3000
